<Layouts.app flash={@flash}>
  <.header>
    Projects
    <:subtitle>Construction loan projects and their submitted documents</:subtitle>
  </.header>

  <.table
    :if={@projects != []}
    id="projects"
    rows={@projects}
    row_click={fn project -> JS.navigate(~p"/projects/#{project.id}") end}
  >
    <:col :let={project} label="Name">{project.name}</:col>
    <:col :let={project} label="Address">{project.address}</:col>
    <:col :let={project} label="Status">
      <span class="badge badge-outline">{project.status}</span>
    </:col>
  </.table>

  <p :if={@projects == []} class="text-base-content/60">
    No projects yet.
  </p>
</Layouts.app>
